  <mj-body background-color="#010101">
    <!-- TROUBLE_VIEWING -->
    <!-- <mj-section padding="8px 16px 0px 16px">
      <mj-column background-color="#1d2124" padding="28px" border="2px solid #148378">
        <mj-text color="#ffffff" align="center" font-size="12px" line-height="1.4">Having trouble viewing this email? <a href="https://raleighcommunitykickstand.org/newsletter/2026_10.html" style="color: #148378; text-decoration: underline">View it in your browser.</a></mj-text>
